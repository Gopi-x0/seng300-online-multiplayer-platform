@startuml SGP-Full-System-Overview
!theme plain
skinparam backgroundColor #FEFEFE
skinparam shadowing false
skinparam defaultFontSize 10
skinparam packageStyle rectangle

title Student Gaming Platform — Full System Class Overview (Umbrella)
footer Iteration 3 · SENG 300 · University of Calgary
caption This diagram provides a condensed view of every type in the system.\nFor full-depth members, see the per-package diagrams (10-model, 20-interfaces-engines, etc.).

' ==================== MODEL ====================
package "model" #F3E5F5 {
    class UserData {
        email, username, password
        TTT stats (7 fields)
        C4 stats (7 fields)
        serialize() / deserialize()
    }
    class GameState {
        gameType, gameStatus
        activePlayerIndex, boardPayLoad
    }
    enum GameStatus {
        SETUP
        IN_PROGRESS
        P1_WINS
        P2_WINS
        DRAW
    }
    enum GameType {
        TTT
        C4
    }
    class PlayerProfile {
        playerId
        username
    }
}

' ==================== INTERFACES ====================
package "interfaces" #FFFDE7 {
    interface "GameEngine<S>" as GE {
        createInitialState()
        validateMove()
        applyMove()
        evaluateEnd()
    }
    class Move {
        row, col
        playerId, symbol
    }
    class MoveResult {
        isValid, message
        errorCode
    }
    enum ValidationCode {
        CELL_OCCUPIED
        OUT_OF_BOUNDS
        WRONG_TURN
        GAME_ALREADY_OVER
        SUCCESS
    }
}

' ==================== CONNECT 4 ====================
package "connect4engine" #E0F7FA {
    class Connect4Game implements GE
    class Connect4State {
        board, player1, player2
        currentPlayer, status, winner
    }
    class Board {
        grid : char 6x7
        dropPiece()
        checkWin()
    }
    class Player {
        id
        symbol
    }
}

' ==================== TIC-TAC-TOE ====================
package "tictactoeengine" #E0F7FA {
    class TicTacToeEngine implements GE
    class "GameState (TTT)" as GTTT {
        board : Symbol 3x3
        activePlayerId
        status, moveHistory
    }
    enum Symbol {
        X
        O
        EMPTY
    }
    enum GameStatusTTT {
        IN_PROGRESS
        X_WINS
        O_WINS
        DRAW
    }
}

' ==================== NETWORK ====================
package "network" #FCE4EC {
    class GameServer {
        port
        send()
        waitForClient()
        shutdown()
    }
    class GameClient {
        connect()
        send()
        shutdown()
    }
    class LobbyManager {
        createLobby()
        removeLobby()
    }
    class LobbySession {
        lobbyCode
        players
        addPlayer()
        startGame()
    }
}

' ==================== SERVICE ====================
package "service" #FFF3E0 {
    class UserManager {
        register()
        login()
        recordGameResult()
        saveUsers()
    }
    class GameSessionManager {
        startGame()
        submitMove()
        submitMoveTTT()
        endGame()
    }
}

' ==================== STUBS ====================
package "stubs" #EFEBE9 {
    class DatabaseStub {
        createUser()
        authenticateUser()
        recordGameResult()
        getGlobalLeaderboard()
    }
    class MatchRecord {
        gameType
        player1Email
        player2Email
        result
    }
}

' ==================== SCREENS ====================
package "screens" #E8F5E9 {
    class MainApp <<Application>>
    class WelcomePage
    class AuthenticationScreen
    class HomePage
    class SettingsScreen
    class ProfileDashboard
    class InstructionsTTT
    class InstructionsC4
    class Lobby
    class HostLobby
    class JoinLobby
    class GameboardTTT
    class GameboardC4
    class ChatWidget
    class WinScreen
}

' ==================== LAYOUT HINTS ====================
screens -[hidden]down-> service
service -[hidden]down-> interfaces
model -[hidden]right-> interfaces
connect4engine -[hidden]right-> tictactoeengine
network -[hidden]right-> stubs

' ==================== KEY RELATIONSHIPS ====================
MainApp --> WelcomePage
MainApp --> AuthenticationScreen
MainApp --> HomePage
MainApp --> GameboardTTT
MainApp --> GameboardC4

GameSessionManager --> GE
GameSessionManager --> Connect4Game
GameSessionManager --> TicTacToeEngine
UserManager --> UserData
GameSessionManager --> GameState
GameSessionManager --> PlayerProfile

HostLobby --> GameServer
HostLobby --> LobbyManager
JoinLobby --> GameClient
GameboardTTT --> GameSessionManager
GameboardC4 --> GameSessionManager
GameboardTTT *-- ChatWidget
GameboardC4 *-- ChatWidget
GameboardTTT ..> WinScreen
GameboardC4 ..> WinScreen

Connect4Game --> Connect4State
Connect4State --> Board
Connect4State --> Player
TicTacToeEngine --> GTTT
DatabaseStub --> MatchRecord

@enduml
