@startuml SGP-Test-Coverage
!theme plain
skinparam backgroundColor #FEFEFE
skinparam shadowing false
skinparam defaultFontSize 11
skinparam packageStyle rectangle
skinparam nodesep 60
skinparam ranksep 30

title Student Gaming Platform — Test Coverage Map
footer Iteration 3 · SENG 300 · University of Calgary

' ============================================================
'  Layout: each test package sits ABOVE its production target.
'  Short downward arrows keep lines from crossing.
' ============================================================

' --- Game Logic ---

together {
    package "test.gamelogic" as tgl #C5CAE9 {
        class Connect4Test <<JUnit>> {
            setup, move validation,
            stacking, turn alternation,
            wins (4 axes), draws, edges
        }
        class TicTacToeTest <<JUnit>> {
            setup, placement, validation,
            out-of-bounds, wrong turn,
            occupied cell, wins, draws
        }
    }
}

together {
    package "connect4engine" #E0F7FA {
        class Connect4Game
        class Connect4State
    }

    package "tictactoeengine" #E0F7FA {
        class TicTacToeEngine
    }
}

Connect4Test -down-> Connect4Game : covers
Connect4Test -down-> Connect4State : covers
TicTacToeTest -down-> TicTacToeEngine : covers

