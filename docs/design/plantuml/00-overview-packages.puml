@startuml SGP-Package-Overview
!theme plain
skinparam backgroundColor #FEFEFE
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontSize 12
skinparam nodesep 80
skinparam ranksep 60

title Student Gaming Platform — Package / Component Overview
footer Iteration 3 · SENG 300 · University of Calgary

' === Layer 1: Application ===

together {
    package "MainApp" as mainapp <<Application>> #E3F2FD {
        [MainApp\n(JavaFX Application)\nCustom title bar\nScreen navigation\nTCP cleanup on close] as MA
    }
}

' === Layer 2: UI ===

together {
    package "screens" as screens <<UI Layer>> #E8F5E9 {
        [WelcomePage] as s1
        [AuthenticationScreen] as s2
        [HomePage] as s3
        [SettingsScreen] as s4
        [ProfileDashboard] as s5
        [InstructionsTTT] as s6
        [InstructionsC4] as s7
        [Lobby] as s8
        [HostLobby] as s9
        [JoinLobby] as s10
        [GameboardTTT] as s11
        [GameboardC4] as s12
        [ChatWidget] as s13
        [WinScreen] as s14
    }
}

' === Layer 3: Service + Network ===

together {
    package "service" as service <<Service Layer>> #FFF3E0 {
        [UserManager\n(file persistence\nsgp_users.dat)] as svc1
        [GameSessionManager\n(engine orchestration)] as svc2
    }

    package "network" as network <<Network Layer>> #FCE4EC {
        [GameServer\n(TCP host)] as n1
        [GameClient\n(TCP guest)] as n2
        [LobbyManager] as n3
        [LobbySession] as n4
    }
}

' === Layer 4: Engines, Model, Interfaces, Stubs ===

together {
    package "connect4engine" as c4engine <<Game Engine>> #E0F7FA {
        [Connect4Game] as c1
        [Connect4State] as c2
        [Board] as c3
        [Player] as c4
    }

    package "tictactoeengine" as tttengine <<Game Engine>> #E0F7FA {
        [TicTacToeEngine] as t1
        [GameState (TTT)] as t2
        [Symbol <<enum>>] as t3
        [GameStatusTicTacToeEngine <<enum>>] as t4
    }
}

together {
    package "interfaces" as ifaces <<Platform Contracts>> #FFFDE7 {
        [GameEngine<S>] as i1
        [Move] as i2
        [MoveResult] as i3
        [ValidationCode <<enum>>] as i4
    }

    package "model" as model <<Domain Model>> #F3E5F5 {
        [UserData] as m1
        [GameState] as m2
        [GameStatus <<enum>>] as m3
        [GameType <<enum>>] as m4
        [PlayerProfile] as m5
    }

    package "stubs" as stubs <<Stub / Future DB>> #EFEBE9 {
        [DatabaseStub] as st1
        [MatchRecord] as st2
    }
}

' === Layout hints to spread bottom packages ===
c4engine -[hidden]right-> tttengine
ifaces -[hidden]right-> model
model -[hidden]right-> stubs

' === Dependencies ===

mainapp -down-> screens : navigates to

screens -down-> service : uses
screens -down-> network : creates /\nsends / receives

service -down-> c4engine : delegates\nmoves
service -down-> tttengine : delegates\nmoves

c4engine -down-|> ifaces : implements\nGameEngine
tttengine -down-|> ifaces : implements\nGameEngine

service -down-> ifaces : uses Move,\nMoveResult
service -down-> model : creates / updates
screens -down-> model : reads DTOs
c4engine -down-> model : reads\nGameStatus
network -down-> model : reads\nGameType
stubs -down-> model : uses\nUserData

note bottom of network
  Real TCP (localhost)
  replaces NetworkStub
  from Iteration 2
end note

note bottom of stubs
  In-memory stub
  documenting future
  DB adapter contract
end note

@enduml
